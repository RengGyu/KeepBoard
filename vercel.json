{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://broadway-font-cornell-daniel.trycloudflare.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://broadway-font-cornell-daniel.trycloudflare.com/uploads/:path*" },
    { "source": "/((?!assets/|favicon.svg|demo-board.svg|component-art-preview.svg|manifest.webmanifest).*)", "destination": "/index.html" }
  ]
}
