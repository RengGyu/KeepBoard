        "statesMeaning": {
          "blank": "starting face",
          "flower": "one successful challenger round recorded",
          "returned": "mat returned after elimination"
        }
      },
      "roundWins": {
        "type": "integer",
        "range": [
          0,
          2
        ],
        "meaning": "successful challenge rounds, not an automatic result unless game-end rule is applied"
      },
      "playedDiscs": {
        "type": "array",
        "order": "bottom-to-top",
        "item": {
          "instanceId": "string",
          "discKind": [
            "flower",
            "skull",
            "last-chance-flower"
          ],
          "face": [
            "down",
            "up"
          ],
          "faceIdentityVisibility": "owner-while-down; public-after-reveal",
          "tablePosition": [
            "on-own-mat",
            "center-after-pass",
            "resolved-area"
          ],
          "roundNumber": "integer-or-null"
        },
        "lastChanceConstraint": "Optional add-on disc; known flower, only the round immediately after award, then returned; each player at most once per game."
      },
      "privateDiscKnowledge": {
        "type": "array",
        "visibility": "owner-only",
        "item": {
          "instanceId": "string-or-null",
          "knownKind": [
            "flower",
            "skull",
            "unknown"
          ],
          "location": [
            "in-hand",
            "face-down-on-own-stack",
            "privately-removed",
            "unknown"
          ],
          "reason": "optional source/event"
        },
        "rule": "Never infer another player’s face-down disc identity."
      },
      "remainingNormalDiscCount": {
        "type": "integer-or-null",
        "range": [
          0,
          4
        ],
        "meaning": "count only; exact identity can remain unknown"
      },
      "lastChance": {
        "status": [
          "not-awarded",
          "awarded-next-round",
          "in-play-this-round",
          "returned-after-round",
          "spent-on-failed-challenge",
          "unknown"
        ],
        "awardedAfterRound": "integer-or-null",
        "oncePerPlayerPerGame": true,
        "knownIdentity": "flower",
        "mayBeUsedOnlyInNextRound": true
      }
    },
    "roundRecord": {
      "number": "integer",
      "phase": [
        "setup",
        "initial-placement",
        "placing-or-open-bid",
        "bidding",
        "challenge-resolution",
        "round-cleanup",
        "game-over",
        "unknown"
      ],
      "firstPlayerId": "player id or null",
      "activePlayerId": "player id or null",
      "placedAtLeastOneDiscByPlayerIds": "ordered array",
      "bid": {
        "amount": "integer-or-null",
        "openedByPlayerId": "player id or null",
        "challengerId": "player id or null",
        "outbidHistory": "ordered array of {playerId,amount}",
        "passedPlayerIds": "clockwise-ordered array"
      },
      "challenge": {
        "targetFlipCount": "integer-or-null",
        "flipHistory": "ordered array of {sequence,playerId,instanceId,face,sourceMatPlayerId}",
        "ownDiscsMustBeFlippedFirst": true,
        "onlyTopmostFaceDownDiscPerMat": true,
        "afterSkullStopImmediately": true,
        "resolution": [
          "pending",
          "success",
          "skull-revealed",
          "unknown"
        ],
        "lossKnowledge": "A non-self skull loss can be identity-unknown; a self-selected loss may be owner-private. Store counts separately from identity."
      },
      "nextRoundFirstPlayerId": "player id or null"
    },
    "gameEnd": {
      "winCondition": [
        "one player reaches two successful challenger rounds",
        "last non-eliminated player"
      ],
      "winnerPlayerId": "player id or null"
    },
    "publicState": {
      "includes": [
        "active seats and clockwise order",
        "mat face and seat-or-center position",
        "public stack counts/order",
        "revealed disc faces",
        "bids and passes",
        "challenge/flip history",
        "round wins",
        "elimination",
        "Last Chance token use state"
      ]
    },
    "privateState": {
      "includes": [
        "owner known identities for own face-down discs",
        "owner private disc-loss identity only when known"
      ],
      "prohibitions": [
        "do not populate opponent hidden identities",
        "unknown remains null/unknown"
      ]
    },
    "physicalConstraints": [
      "Each active player starts with one mat and four normal discs (3 flowers,1 skull), plus one Last Chance disc.",
      "A player receives Last Chance only after failing as challenger and having one normal disc left after the loss; it is usable only in the next round, then returned.",
      "Passing moves that player’s mat toward the center while its played discs remain on it.",
      "Placed discs are stacked with a small visible offset; the physical stack is ordered.",
      "Challenge flips one disc at a time; own discs first; only each mat’s topmost face-down disc is eligible.",
      "A revealed skull immediately ends the challenge and causes a disc loss; when all normal discs are lost, the player is eliminated and returns the mat.",
      "The state model stores observed/recorded facts; it does not implement legal-move enforcement or infer unrevealed identities."
    ],
    "recordConventions": {
      "unknown": "null or explicit unknown; never fill a hidden disc from its probability or component inventory",
      "instanceIdentity": "stable only within a saved session; do not use face identity as a public identifier",
      "stackOrdering": "bottom-to-top in JSON; render visible offsets and flip only the topmost face-down disc",
      "matLocation": "seat while participating; center once passed in the current bidding round; return on elimination",
      "phaseAndHistory": "preserve completed bid and reveal events so resume starts at the saved physical step, without replaying resolved flips"
    }
  },
