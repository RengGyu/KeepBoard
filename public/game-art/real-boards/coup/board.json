    "setupSequence": [
      "Shuffle the 15 character cards (three each for Duke, Assassin, Captain, Ambassador, and Contessa).",
      "Deal two cards face down to each active player; the dealt identities remain owner-private.",
      "Place the remaining character cards as the face-down Court deck in the shared center.",
      "Give each player two coins and keep player coin totals visible; in a two-player game the starting player receives only one coin. Place the remaining coins in the shared Treasury.",
      "Give one summary card to each active player."
    ],
    "resumeRequirements": [
      "Preserve active face-down identities only in their owner-private state; preserve their public count separately.",
      "Preserve each face-up lost influence card and each player’s visible coin total.",
      "Preserve Court-deck count/order only when actually recorded; never derive hidden card identities from a count.",
      "If paused mid-turn, record the declared action, target, response window, pending reveal/exchange, and completed versus pending coin movements.",
      "For a two-player game, preserve whether the standard setup or the optional card variant was used; do not reconstruct one from card counts alone."
    ],
    "assetLimitations": [
      "The six-seat ring is an original neutral arrangement for the variable 2–6 player table, not a fixed printed board.",
      "The Court deck and Treasury card/coin icons are schematic and do not encode live quantities.",
      "No role claim is evidence of the private character card actually held.",
      "This asset describes state placement; it does not validate actions, resolve challenges, perform payments, or advance turns."
    ],
    "setupVariants": [
      {
        "id": "two-player-card-variant",
        "edition": "base-game rulebook optional variant",
        "players": 2,
        "steps": [
          "Divide the 15 cards into three sets of five, each containing one of every character.",
          "Each player secretly keeps one card from one set and discards the rest of that set.",
          "Shuffle the third set, deal one card to each player, and place the remaining three cards face down as the Court deck."
        ],
        "defaultSetup": false,
        "evidenceRef": 2
      }
