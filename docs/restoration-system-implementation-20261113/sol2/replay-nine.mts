const rows=[];for(const file of (await fs.readdir('docs/pro-review-20261113/data/cases')).filter(f=>f.endsWith('.json'))){const d=JSON.parse(await fs.readFile('docs/pro-review-20261113/data/cases/'+file,'utf8')),pack=withRestoration(JSON.parse(await fs.readFile('docs/pro-review-20261113/data/packs/'+d.gameId+'.json','utf8'))),s:any={id:d.caseId,turnInstanceId:d.assertions[0].turnInstanceId,players:[],evidence:d.photos,assertions:d.assertions.map((a:any)=>({...a,observationReceipts:a.observationReceiptRefs.map((i:number)=>d.receipts[i])})),preservations:[],snapshots:[],notes:{}},before=sceneDigest(s),p=projectRestorationScene({session:s,pack});if(before!==sceneDigest(s))throw Error('input mutation');rows.push({case:file,inputUnchanged:true,entities:p.entities.length,boundObjects:p.entities.filter(e=>e.bindings.length).length,profileSHA:p.profile.pin.profileSHA,regions:p.regions.map(r=>({id:r.id,label:r.label,kind:r.kind,boardEntityId:r.boardEntityId,groups:r.groupIds.length,objects:new Set(p.groups.filter(g=>r.groupIds.includes(g.id)).flatMap(g=>g.entityIds)).size})),attachmentEdges:p.relations.filter(r=>r.kind==='attached-to').length,cells:p.entities.filter(e=>e.presentation?.cell).length,native:p.entities.filter(e=>e.presentation?.status==='retained').length});}await fs.writeFile('docs/restoration-system-implementation-20261113/sol2/replay-nine.json',JSON.stringify({providerCalls:0,scope:'existing fixed responses; structural replay, not photo correctness',cases:rows},null,2)+'\n');console.log(rows.map(r=>({case:r.case,objects:r.boundObjects,regions:r.regions.length,cells:r.cells,native:r.native,attachments:r.attachmentEdges})));
