  "components": [
    {
      "id": "locations",
      "name": "장소·막·주요사건",
      "kind": "card",
      "quantity": null,
      "quantity_scope": "unknown",
      "variants": [
        "장소 공개면",
        "장소 미공개면",
        "막",
        "주요사건",
        "연결 표식"
      ],
      "properties": [
        "identity",
        "face",
        "owner",
        "quantity"
      ],
      "description": "2026 코어의 장소는 공개/미공개 양면이며 연결 토큰으로 인접을 나타낸다. 막과 주요사건은 서로 다른 진행 덱이다. 뒷면을 일반 카드 뒷면으로 바꾸지 않고 해당 상태를 별도로 기록한다. 대표형의 정체와 이 범위만 확인했으며 전체 인쇄 앞면·전체 규칙 검증은 아니다.",
      "source_refs": [
        "arkham-lcg.art-confirmation.arkham-lcg-2026-rules"
      ],
      "confidence": "verified"
    },
    {
      "id": "investigators",
      "name": "조사자·자산·적",
      "kind": "card",
      "quantity": null,
      "quantity_scope": "unknown",
      "variants": [
        "조사자 카드",
        "조사자 토큰",
        "자산",
        "적"
      ],
      "properties": [
        "identity",
        "face",
        "owner",
        "quantity"
      ],
      "description": "조사자 카드·미니카드·양면 조사자 토큰과 자산·적 카드는 별개다. 위치·교전/부착 관계와 준비/소진 방향을 기록한다. 전체 카드 앞면 목록은 확인 범위가 아니다. 대표형의 정체와 이 범위만 확인했으며 전체 인쇄 앞면·전체 규칙 검증은 아니다.",
      "source_refs": [
        "arkham-lcg.art-confirmation.arkham-lcg-2026-rules"
      ],
      "confidence": "verified"
    },
    {
      "id": "tokens",
      "name": "단서·파멸·자원·피해·공포",
      "kind": "token",
      "quantity": null,
      "quantity_scope": "unknown",
      "variants": [
        "단서 면",
        "파멸 면",
        "자원",
        "피해",
        "공포"
      ],
      "properties": [
        "identity",
        "face",
        "owner",
        "quantity"
      ],
      "description": "단서/파멸은 양면 토큰이며 자원·피해·공포는 다른 종류다. 표시값과 놓인 대상 카드를 함께 보존한다. 단서/파멸 1·3, 자원1·3·5, 피해/공포1·3 표기가 있다. 대표형의 정체와 이 범위만 확인했으며 전체 인쇄 앞면·전체 규칙 검증은 아니다.",
