// Pure synthetic current-code diagnosis. No API, Store, images, credentials or models.
import {readFileSync,writeFileSync} from 'node:fs';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
import {effectiveRecognitionPack,recognitionFields} from '../../shared/recognition.ts';import {captureFields,captureProfile} from '../../shared/photoCapture.ts';
import {normalizeObservations} from '../../server/ai/index.ts';import {answerField,recompute} from '../../server/engine.ts';import {emptySplendorObservation,unknownGemCounts} from '../../shared/splendor.ts';import type {GamePack,Evidence,Session} from '../../shared/types.ts';
const raw=(JSON.parse(readFileSync('gamepacks/generated/game-essentials.json','utf8')) as GamePack[]).find(p=>p.id==='splendor')!,pack=effectiveRecognitionPack(raw),profile=captureProfile(pack)!;
const target=(areaId:string)=>({version:1 as const,gameId:'splendor',sourceSHA:profile.sourceSHA,areaId});
const photo:Evidence={id:'synthetic-photo',url:'/synthetic-not-an-image.png',label:'합성',kind:'photo',scope:'public',captureEpoch:'epoch',capturedAt:'now',captureTarget:target('player')};
const piece={id:'synthetic-model-card',componentId:'development',variant:null,quantity:1,label:'합성 개발 카드',anchor:'왼쪽',evidenceId:photo.id,region:{x:.1,y:.1,width:.2,height:.3},readout:{...emptySplendorObservation('development'),points:1,bonus:'blue' as const,cost:{...unknownGemCounts(),red:2}}};
const record={version:'game-component-record-v1',pieces:[piece]},read=(field:string,e=photo,value:unknown=record)=>normalizeObservations({assertions:[{field,ownerId:'p1',value,evidenceIds:[e.id]}]},pack,[e],'turn',['p1']);
const allowed=captureFields(pack,[photo],recognitionFields(pack)).map(f=>f.key);assert.deepEqual(allowed,['__photo.public']);
const detected=read('__photo.public');assert.equal(detected.assertions.length,1);assert.equal(detected.assertions[0].ownerId,undefined);assert.equal((detected.assertions[0].value as any).pieces[0].readout.bonus,'blue');assert.equal(read('player.scene').assertions.length,0);
const s:Session={id:'synthetic-session',name:'合成',createdAt:'now',updatedAt:'now',gamePackId:pack.id,gamePackVersion:pack.version,gamePack:pack,captureEpoch:'epoch',turnInstanceId:'turn',stage:'capture',players:[{id:'p1',name:'합성',color:'blue'}],evidence:[photo],assertions:[],preservations:[],snapshots:[],notes:{},activity:[]};
const a=detected.assertions[0];answerField(s,pack,a.field,a.value,a.ownerId);const applied=recompute(s,pack);
assert(s.assertions.some(a=>a.field==='__photo.public'&&a.status==='accepted'));assert(!s.assertions.some(a=>a.field==='player.scene'));assert(!s.assertions.some(a=>['bonus','record-note.bonus','prestige'].includes(a.field)));
// Manually placing the same public evidence in an explicitly chosen owner's field is representable.
answerField(s,pack,'player.scene',a.value,'p1');recompute(s,pack);assert(s.assertions.some(a=>a.field==='player.scene'&&a.ownerId==='p1'&&a.status==='accepted'));assert(!s.assertions.some(a=>a.field==='record-note.bonus'));
const privatePhoto={...photo,ownerId:'p1',scope:'player' as const,captureTarget:target('reserve')},privateRecord={...record,pieces:[{...piece,evidenceId:privatePhoto.id}]};assert.equal(read('reserve.scene',privatePhoto,privateRecord).assertions[0].ownerId,'p1');
const market={...photo,captureTarget:target('market')};assert.equal(read('__photo.public',market).assertions.length,0);assert.equal(read('market.scene',market).assertions.length,1);
const malformed=read('__photo.public',photo,{...record,pieces:[{...piece,readout:{...piece.readout,points:-1}}]});assert.equal(malformed.assertions.length,1);assert.equal((malformed.assertions[0].value as any).pieces[0].readout.kind,null);
const paths=['shared/recognition.ts','shared/photoCapture.ts','shared/capture-profiles.json','shared/genericRecord.ts','shared/splendor.ts','server/ai/index.ts','server/ai/generic.ts','server/ai/splendor.ts','server/engine.ts','src/GameEssentials.tsx','src/SplendorEditor.tsx','src/PhotoCaptureGuide.tsx','gamepacks/generated/game-essentials.json'];
const out={status:'PASS_SCOPED_DIAGNOSIS',checks:[{case:'player-public selected capture with fully readable synthetic development card',allowedFields:allowed,observedKind:'development',bonus:'blue',ownerId:null},{case:'model directly assigns player.scene/p1 from public capture',candidateCount:0},{case:'apply unassigned candidate',acceptedField:'__photo.public',createsPlayerHoldings:false,createsBonusTotal:false},{case:'explicit manual chosen-owner entry',acceptedField:'player.scene',ownerId:'p1',sameEvidenceAllowed:true,createsBonusTotal:false},{case:'owner-private reserve selection',acceptedCandidateField:'reserve.scene',ownerId:'p1'},{case:'market-only selection',marketCandidates:1,unassignedCandidates:0},{case:'malformed printed details',physicalCardRetained:true,readoutKind:null}],edition:profile.editionId,sourceSHA:profile.sourceSHA,packVersion:pack.version,derivedRules:pack.derivedRules.length,sourceFiles:Object.fromEntries(paths.map(p=>[p,createHash('sha256').update(readFileSync(p)).digest('hex')])),networkCalls:0,AIcalls:0,userDataRead:false,productWrites:0};writeFileSync('docs/splendor-purchased-card-diagnosis/results.json',JSON.stringify(out,null,2)+'\n');console.log(JSON.stringify({status:out.status,cases:out.checks.length,networkCalls:0,AIcalls:0,productWrites:0}));
