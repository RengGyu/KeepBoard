  "findings": [
    {
      "id": "D1",
      "level": "VERIFIED",
      "claim": "Product direct Gemini uses generateContent with 120s and no explicit thinking/resolution; measured Argon Interactions calls were about149-150s. Same latency would cross that boundary; this does not measure generateContent latency.",
      "files": [
        "server/ai/index.ts",
        "gateway/server.mjs"
      ],
      "decision": "Explicit Interactions protocol adapter and complete response decoder; no model-name-only rollout."
    },
    {
      "id": "D2",
      "level": "VERIFIED",
      "claim": "hostedJSON hardcodes DeepSeek/high/180s; cloud durable jobs exist and paid analyzeBatch maxRetries is0.",
      "files": [
        "gateway/server.mjs",
        "server/cloudRuntime.ts",
        "workflows/analyze.ts"
      ],
      "decision": "Reuse both local/cloud jobs, wire same provider contract and structured failure; no second queue."
    },
    {
      "id": "D3",
      "level": "VERIFIED",
      "claim": "Experiment Argon total_output_tokens excludes thoughts in both successful raw usage receipts; finalJSON product parser expects different payload shape.",
      "decision": "Provider-specific usage decoder; preserve completed JSON, do not expose reasoning."
    },
    {
      "id": "D4",
      "level": "VERIFIED",
      "claim": "market capture target allows market.scene/development; it is a semantic selection, not an image crop. PhotoDialog saves a new photo without a parent transform.",
      "files": [
        "shared/capture-profiles.json",
        "shared/photoCapture.ts",
        "src/Capture.tsx"
      ],
      "decision": "One real area photo; bbox belongs to that evidence only; no implicit source-to-board coordinate mapping."
    },
    {
      "id": "D5",
      "level": "VERIFIED",
      "claim": "Existing GameEssentials.applyCandidate replaces the field through api.update; componentLinking supports explicit selected piece append with target revision.",
      "decision": "Do not call field replacement a partial merge; use existing explicit link for adding to a recorded market."
    },
    {
      "id": "D6",
      "level": "RECOMMENDATION",
      "claim": "Add a pinned request plan fingerprint to existing job signature/reuse; include model/protocol/prompt/schema/input hashes and scope.",
      "decision": "No global result cache; same-job reuse only; no auto retry/cascade."
    },
