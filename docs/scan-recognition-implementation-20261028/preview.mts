import {mkdtemp,writeFile} from 'node:fs/promises';import os from 'node:os';import path from 'node:path';
import {createApp} from '../../server/index';import {Store} from '../../server/store';import {GeminiGameReader,decodeGeminiGameObservation} from '../../server/ai/geminiGameReader';import {decodeCatanSceneReading} from '../../server/ai/catanSceneReading';
class PreviewReader extends GeminiGameReader{
 async status(){return {kind:'gemini-game-observation-v1' as const,available:true,cloudSupported:true as const,identity:this.identity};}
 async read(request:any,definition:any){const raw=decodeGeminiGameObservation({candidates:[{finishReason:'STOP',content:{parts:[{text:JSON.stringify({items:[{kind:'number-token',box_1000:[100,100,200,200],face:'front',quantity:1,attributes:[{id:'number',valueJson:null,unknownReason:'occluded'}]}]})}]}}]},request,definition);return {raw,timings:{readerMs:1}};}
 async readCatanScene(request:any,definition:any,session:any,pack:any,evidence:any){const components=[{id:'land',kind:'terrain',variant:'forest',quantity:1,face:'front',location:{type:'hex',id:'r1c1'},region:{x:.1,y:.1,width:.1,height:.1},evidenceId:evidence[0].id},{id:'number',kind:'number-token',number:8,quantity:1,face:'front',location:{type:'hex',id:'r1c1'},region:{x:.1,y:.1,width:.1,height:.1},evidenceId:evidence[0].id}];return {result:decodeCatanSceneReading({candidates:[{finishReason:'STOP',content:{parts:[{text:JSON.stringify({assertions:[{field:'board.layout',value:{version:2,coverage:'partial',components},evidenceIds:[evidence[0].id]}],warnings:[]})}]}}]},{request,definition,session,pack,evidence,reader:this.identity,sourceImageSHA:request.images[0].sha256}),timings:{readerMs:1}};}
}
const root=await mkdtemp(path.join(os.tmpdir(),'kb-scan-preview-')),store=new Store(root),app=await createApp({store,geminiReader:new PreviewReader(),ui:true,uiHmr:false}),server=app.listen(0,'127.0.0.1');await new Promise<void>(r=>server.once('listening',r));const port=(server.address() as any).port,base=`http://127.0.0.1:${port}`;
const post=async(p:string,b:any)=>{const r=await fetch(base+'/api'+p,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)});if(!r.ok)throw Error('fixture '+r.status);return r.json();};
let v=await post('/sessions',{gamePackId:'catan-base',name:'[합성] 다중 스캔 검수'});const id=v.session.id;const png=Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+a9H8AAAAASUVORK5CYII=','base64');
for(let i=0;i<2;i++)v=await post(`/sessions/${id}/evidence`,{dataUrl:'data:image/png;base64,'+Buffer.concat([png,Buffer.from(String(i))]).toString('base64'),scope:'public',label:'합성사진 '+i});
const out={url:base+'/?session='+id,port,pid:process.pid,root,modelCalls:0,reader:'test-only PreviewReader'};await writeFile('docs/scan-recognition-implementation-20261028/preview.json',JSON.stringify(out,null,2)+'\n');console.log(JSON.stringify(out));
process.on('SIGTERM',()=>server.close(()=>process.exit(0)));
