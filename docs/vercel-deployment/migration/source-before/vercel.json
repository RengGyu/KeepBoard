{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mba-estate-aid-gordon.trycloudflare.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://mba-estate-aid-gordon.trycloudflare.com/uploads/:path*"
    },
    {
      "source": "/((?!assets/|game-art/|carcassonne-art/|brand/|demo/|favicon.svg|demo-board.svg|component-art-preview.svg|manifest.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
