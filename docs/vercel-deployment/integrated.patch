+ async list(session:string,owner?:string){return (await readJSON<Stored[]>(this.objects,this.index(session,owner)))?.value.filter(j=>Date.now()-Date.parse(j.updatedAt)<86400000).sort((a,b)=>b.createdAt.localeCompare(a.createdAt)).map(j=>this.public(j))??[];}
