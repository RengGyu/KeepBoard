{
  "name": "keepboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:vercel": "tsc --noEmit && vite build --outDir cloud-dist && nitro build"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "nitro": "^3.0.260903-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.65.0",
    "workflow": "^5.2.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
