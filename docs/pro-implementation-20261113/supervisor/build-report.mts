/** Publish existing photo judgments separately from the newly derived product layout. */
import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
const here=path.dirname(fileURLToPath(import.meta.url)),audit=path.resolve(here,'../photo-audit'),out=path.join(here,'report');
const metrics=JSON.parse(await fs.readFile(path.join(audit,'metrics.json'),'utf8'));
const replay=JSON.parse(await fs.readFile(path.join(here,'replay-result.json'),'utf8'));
const anchors=JSON.parse(await fs.readFile(path.join(here,'current-photo-anchors.json'),'utf8'));
await fs.mkdir(out,{recursive:true});
for(const f of ['ground-truth.json','placement-audit.csv','matched-results.csv','metrics.json','photo-amendments.json','source-integrity.json'])await fs.copyFile(path.join(audit,f),path.join(out,f));
await fs.copyFile(path.join(here,'replay-result.json'),path.join(out,'current-connection-counts.json'));
await fs.copyFile(path.join(here,'current-photo-anchors.json'),path.join(out,'current-photo-anchors.json'));
await fs.cp(path.join(audit,'crops'),path.join(out,'crops'),{recursive:true});
await fs.cp(path.join(here,'screenshots'),path.join(out,'screenshots'),{recursive:true});
const esc=(s:unknown)=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
const sRows=['sagrada-baseline','sagrada-high','sagrada-medium','sagrada-low'].map(id=>{const m=metrics.nine_cases[id],a=m.attribute_counts,p=m.placement_counts;return `<tr><td>${esc(id.replace('sagrada-',''))}</td><td>${a.match??0} / ${a.definite_misread??0} / ${a.app_unknown??0}</td><td>${p.match??0}/18</td></tr>`;}).join('');
const cRows=replay.rows.map((r:any)=>`<tr><td>${esc(r.caseId)}</td><td>${r.before.placed}/${r.before.total}</td><td>${r.after.placed}/${r.after.total}</td></tr>`).join('');
const seven=metrics.nine_cases['seven-wonders-baseline'];
const shots=[['sagrada','사그라다'],['lost-cities','로스트 시티'],['seven-wonders','세븐 원더스']].map(([id,name])=>`<section><h2>${name} · 원사진과 현재 화면</h2><a href="screenshots/${id}-landscape.png"><img loading="lazy" src="screenshots/${id}-landscape.png" alt="${name} 원사진과 현재 제품 복원판의 가로 모바일 크기 Chrome 캡처"></a></section>`).join('');
const html=`<!doctype html><html lang="ko"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>KeepBoard · 사진 대조와 관계 복원</title><style>*{box-sizing:border-box}body{margin:0;background:#f4f7fa;color:#16305c;font:15px system-ui,sans-serif}main{max-width:1000px;margin:auto;padding:18px}p,li{line-height:1.6}h1{font-size:26px}h2{font-size:19px;margin-top:32px}a{color:#1959a1}.go{display:block;padding:16px;background:#16305c;color:white;border-radius:10px;font-weight:700;text-decoration:none}.pan{overflow:auto}table{border-collapse:collapse;font-size:14px;white-space:nowrap}th,td{padding:10px;border-bottom:1px solid #c2cddd;text-align:left}small{font-size:12px}li{margin-bottom:8px}img{max-width:100%;height:auto}details{margin:16px 0}.note{border-left:4px solid #bd741b;padding-left:12px}</style><main><small>2026.11.13 · 기존 원사진·저장 응답 · 새 판독 0회</small><h1>사진과 답을 대조하고<br>판 연결을 고쳤습니다</h1><a class="go" href="../boards/">현재 제품 코드로 복원판 보기 →</a><p>선택 → 정정 시험으로 관계·판 방향을 고쳐 볼 수 있습니다. 이 공유 화면은 <b>화면 안의 임시 수정</b>이며 서버 저장·새 판독은 실행하지 않습니다.</p>
<h2>무엇을 고쳤나</h2><ul><li>다른 기록 영역의 같은 사진 판도 검증된 참조로 연결합니다.</li><li>순환·여러 단계 부착에서도 실물이 사라지지 않도록 표시합니다.</li><li>판 방향·A/B 편·묶음·물리 순서를 구분합니다. 가까운 판 중심만으로 소속을 확정하지 않습니다.</li><li>원사진의 네 모서리를 눌러 판 기준을 정정합니다. 원관측 값·좌표는 유지합니다.</li></ul>
<h2>원사진 직접 대조: 사그라다</h2><p>전경 주사위 18개, 색·눈 <b>36속성만</b> 비교했습니다. 제품 전체나 다른 사진의 정확도는 아닙니다. 사진을 먼저 본 Sol 작업자의 판정이며 사람 정답 인증은 아닙니다.</p><div class="pan"><table><tr><th>저장 응답</th><th>맞음 / 오독 / 모름 (36)</th><th>기존 칸 일치</th></tr>${sRows}</table></div><p>이 사진에서는 medium이 high보다 좋았습니다. 한 사진·한 응답 결과로 제품 기본 강도를 바꾸지는 않았습니다. low의 값과 창문 칸 연결 실패도 별개로 기록했습니다.</p><a href="crops/sagrada-foreground.png"><img loading="lazy" src="crops/sagrada-foreground.png" alt="실제 사그라다 전경 창문 사진의 확대 영역"></a>
<h2>원사진 직접 대조: 로스트 시티</h2><p>가까운 노랑 줄은 <b>3·4·5·9·10</b>입니다. high의 6은 9 오독입니다. medium·low의 추가 8은 인접한 상자와 겹쳐 별도 실물인지 판단을 유보했습니다.</p><p>medium 상자는 사진의 세로 위치와 일관된 차이가 있어 대응을 유보했습니다. 배율을 가정하면 35개 후보가 대응하지만, 원좌표를 자동으로 고치거나 이를 정확도 점수로 쓰지 않았습니다. 중앙 버림·뒤집힌 더미·가린 카드는 원정 줄과 구분했습니다.</p>
<h2>원사진 직접 대조: 세븐 원더스</h2><p>이전 저장 구조 117개를 확인한 결과: <b>${seven.correctly_anchored}개 소속 일치 · ${seven.wrong_anchor}개 다른 판 · ${seven.unassigned_but_photo_decidable}개 소속은 보이나 미분류 · ${seven.withheld}개 유보</b>. 31개 층화 표본 크롭을 보존했습니다.</p><p>같은 사진 판정에 현재 코드를 대응하면 <b>${anchors.after.match??0}개 일치 · ${anchors.after['wrong-anchor']??0}개 다른 판 · ${anchors.after.unassigned??0}개 미연결 · ${anchors.after.withheld??0}개 유보</b>입니다. 판정 가능한 실물을 자동으로 모두 연결한 것은 아닙니다.</p><p class="note">사진에는 판 무리가 5개지만 응답의 불가사의판 anchor는 4개입니다. 없는 판을 만들어 연결하지 않습니다. 새 코드의 연결 수가 줄어드는 경우는 잘못된 최근접 확정을 없앤 결과이며, 위치가 모두 해결됐다는 뜻은 아닙니다.</p>
<h2>이번 코드로 다시 계산한 연결 수</h2><p><b>연결 수는 위치 정답 수가 아닙니다.</b> 아래는 기존9응답을 새 코드로 계산한 수입니다. 위 사진 판정표는 수정 전 구조의 독립 대조이며 섞어 점수화하지 않았습니다.</p><div class="pan"><table><tr><th>기존 응답</th><th>수정 전 연결</th><th>현재 연결</th></tr>${cRows}</table></div>
${shots}<p>위 캡처는 Chrome의844×390 모바일 크기 첫 화면입니다. 전체 판·실제 iPhone Safari 터치를 인증하는 이미지가 아닙니다. 세로390×844와 실제 DOM 정정도 별도로 확인했습니다.</p><h2>직접 확인</h2><ol><li>복원판에서 실물을 선택하고 원사진 테두리를 비교합니다.</li><li>정정 시험에서 판·부착·방향을 고치고 관련 묶음이 함께 바뀌는지 봅니다.</li><li>아이폰 Safari에서 확대·가로 밀기·선택을 확인합니다. 실제 기기 확인은 아직 사용자 확인이 필요합니다.</li></ol>
<details><summary>정답 초안·대조표·한계</summary><p><a href="ground-truth.json">사진 판정 원장</a> · <a href="placement-audit.csv">수정 전 위치 대조 CSV</a> · <a href="matched-results.csv">값 대조 CSV</a> · <a href="metrics.json">범위·분모 JSON</a> · <a href="photo-amendments.json">판정 수정 기록</a> · <a href="current-connection-counts.json">현재 연결 계산</a> · <a href="current-photo-anchors.json">같은 사진 판정으로 현재 anchor 대조</a></p><p>모르는 값·가림·대응 불가·위치 오류는 따로 남겼습니다. 전체120종 정확도·오답률5~10% 달성·실폰 종단은 인증하지 않습니다. 추가 유료 호출·자동 분할·새 렌더러는 없습니다.</p></details><p><a href="../current/">이전8장 화면</a> · <a href="../audit/">이전 속도 실험</a></p></main></html>`;
await fs.writeFile(path.join(out,'index.html'),html);console.log(JSON.stringify({out,judgments:'Sol direct photo review; not human certification',providerCalls:0}));
