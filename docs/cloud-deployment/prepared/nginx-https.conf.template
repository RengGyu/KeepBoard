# Replace only __STATIC_IP__ with the attached public IPv4, after trusted issuance.
server {
    listen 80 default_server;
    server_name __STATIC_IP__;
    location ^~ /.well-known/acme-challenge/ { root /var/www/keepboard-acme; }
    location / { return 308 https://__STATIC_IP__$request_uri; }
}
server {
    listen 443 ssl;
    server_name __STATIC_IP__;
    ssl_certificate /etc/letsencrypt/live/__STATIC_IP__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__STATIC_IP__/privkey.pem;
    client_max_body_size 80m;
    location / {
        proxy_pass http://127.0.0.1:4319;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 250s;
        proxy_send_timeout 250s;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
