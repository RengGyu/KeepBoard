[Unit]
Description=KeepBoard app and loopback AI gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keepboard
Group=keepboard
WorkingDirectory=/opt/keepboard/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4319
Environment=KEEPBOARD_DATA_DIR=/var/lib/keepboard
EnvironmentFile=/etc/keepboard.env
ExecStart=/opt/keepboard/node/bin/node --import tsx deploy/cloud-launch.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
