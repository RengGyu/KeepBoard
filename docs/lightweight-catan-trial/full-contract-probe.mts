// No model or settings. Actual recorded photo output plus separate synthetic Catan contracts.
import assert from 'node:assert/strict';
import {readFile,writeFile,mkdtemp} from 'node:fs/promises';
import path from 'node:path';
import {tmpdir} from 'node:os';
import {fileURLToPath} from 'node:url';
import {normalizeSceneDetailed,createComponent,CATAN_TOPOLOGY,COASTAL_EDGES,type ComponentScene} from '../../shared/scene.ts';
import {groupSceneComponents} from '../../src/sceneGroups.ts';
import {editSceneSelection} from '../../shared/sceneEditing.ts';
import {moveSceneComponent} from '../../shared/sceneMoves.ts';
import {harborAccess,tradeRates} from '../../shared/catanSummary.ts';
import {Store} from '../../server/store.ts';
const here=path.dirname(fileURLToPath(import.meta.url));
const raw=JSON.parse(await readFile(path.join(here,'lightweight.raw.json'),'utf8'));
const intermediate=JSON.parse(await readFile(path.join(here,'lightweight.normalized.json'),'utf8'));
const compatible=JSON.parse(await readFile(path.join(here,'lightweight.scene-v2.json'),'utf8'));
const native=normalizeSceneDetailed(intermediate,['research-photo-1']).scene;
const by=(s:any,id:string)=>s.components.find((c:any)=>c.id===id);
const nativeLabels=raw.components.filter((c:any)=>by(native,c.id)?.label===c.label).length;
const nativeNotes=raw.components.filter((c:any)=>by(native,c.id)?.note===c.notes).length;
const nativeNumbers=raw.components.filter((c:any)=>c.number!==null&&by(native,c.id)?.number===c.number).length;
const adapted=normalizeSceneDetailed(compatible,['research-photo-1']).scene;
const adaptedLabels=raw.components.filter((c:any)=>by(adapted,c.id)?.note.includes(c.label)).length;
const adaptedNumbers=raw.components.filter((c:any)=>c.number!==null&&by(adapted,c.id)?.note.includes(`표시 숫자 ${c.number}`)).length;
assert.equal(native.components.length,67);assert.equal(adapted.components.length,67);assert.equal(nativeLabels,0);assert.equal(nativeNotes,0);assert.equal(nativeNumbers,18);assert.equal(adaptedLabels,67);assert.equal(adaptedNumbers,18);
const groups=groupSceneComponents(adapted);const cardIds=raw.components.filter((c:any)=>c.paletteId==='part-8').map((c:any)=>c.id);
const cardGroups=groups.filter(g=>g.ids.some(id=>cardIds.includes(id)));
const ownerChanged=editSceneSelection(adapted,['red-city-1'],{ownerId:'blue'});
const deleted=editSceneSelection(adapted,['red-city-1','red-road-1'],'delete');
assert.equal(ownerChanged,adapted);assert.equal(deleted.components.length,65);assert.equal(adapted.components.length,67);
const move=moveSceneComponent(adapted,'red-road-1',{type:'edge',id:CATAN_TOPOLOGY.edges[0].id});
assert.equal(move.status,'moved');
const overlap=moveSceneComponent(move.scene,'blue-road-1',{type:'edge',id:CATAN_TOPOLOGY.edges[0].id});
assert.equal(overlap.status,'moved');
assert.deepEqual(by(overlap.scene,'red-road-1').location,by(overlap.scene,'blue-road-1').location);
assert.equal(cardGroups.length,1);assert.equal(cardGroups[0].ids.length,6);
assert.equal(harborAccess(adapted,'red').length,0);
assert.equal(tradeRates(adapted,'red').complete,false);

// These manually named slots are synthetic and do NOT derive from the photographed crop coordinates.
const empty:ComponentScene={version:2,coverage:'partial',components:[]};
const roadA=createComponent(empty,'road',{id:'a',ownerId:'red',quantity:1,location:{type:'edge',id:CATAN_TOPOLOGY.edges[0].id}});
const roadB=createComponent(empty,'road',{id:'b',ownerId:'blue',quantity:1,location:{type:'edge',id:CATAN_TOPOLOGY.edges[1].id}});
const synthetic={...empty,components:[roadA,roadB]};const swapped=moveSceneComponent(synthetic,'a',roadB.location);
assert.equal(swapped.status,'swapped');assert.deepEqual(by(swapped.scene,'b').location,roadA.location);assert.deepEqual(by(synthetic,'a').location,roadA.location);
const edge=COASTAL_EDGES[0];
const harbor=createComponent(empty,'harbor',{id:'port',quantity:1,variant:'lumber',ratio:2,location:{type:'edge',id:edge.id}});
const house=createComponent(empty,'settlement',{id:'house',quantity:1,ownerId:'red',location:{type:'vertex',id:edge.vertexIds[0]}});
const portScene={...empty,components:[harbor,house]};assert.equal(harborAccess(portScene,'red').length,1);assert.equal(tradeRates(portScene,'red').rates.lumber.ratio,2);assert.equal(tradeRates(portScene,'red').rates.ore.ratio,4);
const store=new Store(await mkdtemp(path.join(tmpdir(),'keepboard-full-contract-')));
const session:any={id:'adapted-output',updatedAt:'synthetic',gamePack:JSON.parse(await readFile(path.join(here,'compiled-profile.json'),'utf8')),assertions:[{id:'observed',field:'components.observed',value:adapted,status:'candidate',basis:'observation',evidenceIds:['research-photo-1']}],snapshots:[{id:'s',assertions:[{value:adapted}]}],notes:{red:'synthetic private note'},evidence:[]};
await store.saveSession(session);const reloaded=await store.getSession(session.id);assert.deepEqual(reloaded,JSON.parse(JSON.stringify(session)));
await writeFile(path.join(here,'full-contract-probe.json'),JSON.stringify({status:'passed',actualRawComponents:67,nativeV2:{componentIdsPreserved:67,readableLabelsPreserved:nativeLabels,descriptionsPreserved:nativeNotes,structuredNumbersPreserved:nativeNumbers},noteAdapter:{labelsPreserved:adaptedLabels,readableNumbersInNote:adaptedNumbers,structuredNumbersPreserved:adapted.components.filter(c=>c.number!==null).length,exactStoreReload:true},actualOutputActions:{genericOwnerEdit:'noop',multiDelete:'two removed; original unchanged',unknownSlotMove:move.status,secondUnknownToOccupiedSlot:overlap.status,unknownPiecesOverlapInsteadOfRoadSwap:true,distinctCardGroups:cardGroups.length,distinctCardIds:6,harborAccess:0,tradeRatesComplete:false},separateSyntheticCatanC:{roadSwap:'passed, source unchanged',harborEndpointAccess:'passed',lumberRate:2,otherResourceRate:4,scope:'pure helper tests, no photo-to-slot inference, not current photo editor UI'}},null,2)+'\n');
console.log('FULL CONTRACT PASS: raw semantics loss reproduced; note adapter/store verified; A gaps vs separate synthetic C actions checked.');
