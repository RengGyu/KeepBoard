{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keepboard.local/game-specifications/schema/1.0",
  "title": "KeepBoard reusable game specification 1.0",
  "description": "Definition/research contract, not live game data or a rules truth certificate.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "game_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name_ko": {
      "type": "string",
      "minLength": 1
    },
    "name_en": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "$ref": "#/$defs/edition"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "minItems": 1
    },
    "layout": {
      "type": "object",
      "properties": {
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/area"
          },
          "minItems": 1
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          },
          "minItems": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "areas",
        "relations",
        "notes"
      ],
      "additionalProperties": false
    },
    "state_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      },
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 0
    },
    "resume": {
      "type": "object",
      "properties": {
        "required_field_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][A-Za-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "pending_action_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][A-Za-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "preserve_procedures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preserve"
          },
          "minItems": 0
        },
        "opening_policy": {
          "const": "retain-saved-turn"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "required_field_ids",
        "pending_action_fields",
        "preserve_procedures",
        "opening_policy",
        "notes"
      ],
      "additionalProperties": false
    },
    "recognition_correction": {
      "type": "object",
      "properties": {
        "photographable_field_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][A-Za-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "must_ask_field_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][A-Za-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "never_infer": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "correction_targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 1
        },
        "privacy_policy": {
          "const": "owner-scoped"
        }
      },
      "required": [
        "photographable_field_ids",
        "must_ask_field_ids",
        "never_infer",
        "correction_targets",
        "privacy_policy"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension"
      },
      "minItems": 0
    },
    "custom_setup": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "editable_area_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][A-Za-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "editable_component_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][A-Za-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "invariant_rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][A-Za-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "allowed",
        "description",
        "editable_area_ids",
        "editable_component_ids",
        "invariant_rule_ids"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 0
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "game_id",
    "name_ko",
    "name_en",
    "edition",
    "components",
    "layout",
    "state_fields",
    "rules",
    "resume",
    "recognition_correction",
    "extensions",
    "custom_setup",
    "sources",
    "confidence",
    "gaps"
  ],
  "additionalProperties": false,
  "$defs": {
    "confidence": {
      "enum": [
        "verified",
        "reported",
        "unclear",
        "recommendation"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][A-Za-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://[^\\s]+$"
        },
        "kind": {
          "enum": [
            "official-rules",
            "official-product",
            "official-faq",
            "secondary",
            "implementation",
            "unverified"
          ]
        },
        "access": {
          "enum": [
            "opened",
            "search-index",
            "unavailable",
            "not-checked"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "kind",
        "access",
        "checked_at",
        "note"
