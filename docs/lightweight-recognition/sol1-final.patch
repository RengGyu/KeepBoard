+import type {Assertion,SessionView} from '../shared/types';
+import type {ComponentScene} from '../shared/scene';
+import {normalizeScene} from '../shared/scene';
+import {mergeBoardObservation} from '../shared/boardRecording';
+import {moveSceneComponent} from '../shared/sceneMoves';
+export function localCatanCandidates(view:SessionView){
+ if(view.pack.id!=='catan-base')return [];
+ const board=view.session.assertions.filter(a=>a.field==='board.layout'&&!a.ownerId&&a.status==='accepted').at(-1);
+ return view.session.assertions.filter(a=>!a.ownerId&&a.status==='candidate'&&a.observationReceipts?.length&&['board.layout','components.observed'].includes(a.field)&&(!board||a.updatedAt>board.updatedAt));
+}
+/** Consume computed geometry only after the user's explicit review action. No coordinate solver here. */
+export function catanReviewScene(source:Assertion,base:ComponentScene,useLocations:boolean){
+ let incoming=normalizeScene(source.value);
+ if(useLocations){for(const receipt of source.observationReceipts??[]){for(const candidate of receipt.geometryCandidates){const id=receipt.componentRefs[candidate.observationRef];if(!id)continue;const result=moveSceneComponent(incoming,id,candidate.locationCandidate,{intent:'correct'});if(result.status==='rejected')throw Error(result.message);incoming=result.scene;}}}
+ return mergeBoardObservation(base,incoming);
+}
