+ assert(manifest.games.find((g:any)=>g.gameId==='splendor')!.physicalPreserve.some((p:any)=>p.scope==='shared-secret')); assert.equal(s.components.find(c=>c.id==='development')!.properties.find(p=>p.id==='cost')!.type,'marks');
