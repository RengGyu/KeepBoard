await write('preparation.json',JSON.stringify(report,null,2)+'\n');await mkdir(path.dirname(reportFile),{recursive:true});const f=await open(reportFile,'w',0o600);await f.writeFile(JSON.stringify(report,null,2)+'\n');await f.close();console.log(JSON.stringify({status:report.status,atlas:report.atlas,denominators:report.denominators,modelRequests:0}));
