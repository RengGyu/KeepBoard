for(const [i,mode]of ['original','catan-atlas'].entries()){
 const plan=await prepareLocalObservation({pack,evidence:[{id:frame.sourceEvidenceId,url:'private-evaluation-only',capturedAt:new Date(0).toISOString(),captureEpoch:'frozen-comparison-prepare-only',scope:'public',kind:'photo'}],captureEpoch:'frozen-comparison-prepare-only',selection:{kind:'local-observation-v1',task:'catan-numerals-v1',definitionSHA:definition.definitionSHA,areaId:'board',inputMode:mode,frame},taskId:'N'+(i+1)+'-prepared-not-dispatched',reader,cloud:false,readImage:async()=>({data:source,mimeType:'image/jpeg'})});
 const actual=i?atlas.data:source,body={model:reader.config.modelAlias,messages:[{role:'user',content:[{type:'text',text:QWEN_NUMBER_PROMPT},{type:'image_url',image_url:{url:'data:'+(i?'image/png':'image/jpeg')+';base64,'+actual.toString('base64')}}]}],response_format:{type:'json_schema',json_schema:{name:'qwen_number_grounding',strict:true,schema:QWEN_NUMBER_SCHEMA}},temperature:0,max_tokens:1024,stream:false,cache_prompt:false};
 const artifact=await write('N'+(i+1)+'-plan.json',JSON.stringify(plan));plans.push({id:'N'+(i+1),mode,plan:artifact,requestSHA256:sha(JSON.stringify(plan.request)),readerRequestBodySHA256:sha(JSON.stringify(body)),input:inputs[i],inputDimensions:plan.request.images[0],taskProfile:plan.taskProfile,reader:plan.reader,frameId:frame.frameId});
}
