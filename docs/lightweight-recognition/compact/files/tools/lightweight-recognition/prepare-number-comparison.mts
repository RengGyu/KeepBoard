const [metadataFile,sourceFile,configFile,privateDir,reportFile]=process.argv.slice(2);if(!reportFile)throw Error('metadata source config private-output report required');
const sha=(b:Buffer|string)=>createHash('sha256').update(b).digest('hex'),metadata=JSON.parse(await readFile(metadataFile,'utf8')),source=await readFile(sourceFile),frameBytes=await readFile(metadata.privateFramePath);
