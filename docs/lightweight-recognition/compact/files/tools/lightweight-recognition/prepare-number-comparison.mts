const gtBytes=await readFile(metadata.privateGTPath);if(sha(gtBytes)!==metadata.privateGTSHA256)throw Error('Frozen GT drift');const gt=JSON.parse(gtBytes.toString());
const inside=(point:{x:number;y:number},polygon:{x:number;y:number}[])=>{let hit=false;for(let i=0,j=polygon.length-1;i<polygon.length;j=i++){const a=polygon[i],b=polygon[j];if((a.y>point.y)!==(b.y>point.y)&&point.x<(b.x-a.x)*(point.y-a.y)/(b.y-a.y)+a.x)hit=!hit;}return hit;};
const centers=gt.objects.map((o:any)=>{const c=o.center_pixels;return {x:(Array.isArray(c)?c[0]:c.x)/metadata.sourceDimensions[0],y:(Array.isArray(c)?c[1]:c.y)/metadata.sourceDimensions[1]};});
