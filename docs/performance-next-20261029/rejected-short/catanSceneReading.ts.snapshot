import type {AnalysisResult,Evidence,GamePack,Session} from '../../shared/types';
import {normalizeScene,sceneJSONSchema} from '../../shared/scene';
import {OBSERVATION_VERSION,validateObservationResult,type ObservationReceipt,type ObservationRequest,type PhotoDefinition,type HostedReaderIdentity} from '../../shared/lightweightRecognition';
import {validateDetailValue} from '../../shared/readouts/registry';
import {decodeProviderJSON} from './response';
import {normalizeObservations} from './index';

/** Convert the existing native schema's Gemini-style nullable/type spelling to the same JSON-schema wire used by the reader. */
export function catanSceneResponseSchema(evidence:Evidence[]){
 const convert=(value:unknown):any=>{if(Array.isArray(value))return value.map(convert);if(!value||typeof value!=='object')return value;const source=value as Record<string,unknown>,out:Record<string,unknown>={};for(const [key,item]of Object.entries(source)){if(key==='nullable'||key==='propertyOrdering')continue;out[key]=key==='type'&&typeof item==='string'?item.toLowerCase():convert(item);}if(source.nullable===true){out.type=[out.type,'null'];if(Array.isArray(out.enum))out.enum=[...out.enum,null];}return out;};
 const scene=convert(sceneJSONSchema);
 // Only the single-photo wire is smaller. The shared scene contract and decoder still accept full legacy scenes.
 scene.properties.components.items.required=scene.properties.components.items.required.filter((key:string)=>!['variant','ownerId','evidenceId'].includes(key));
 return {type:'object',properties:{summary:{type:'string'},assertions:{type:'array',maxItems:1,items:{type:'object',properties:{field:{type:'string',enum:['board.layout','components.observed']},value:scene,evidenceIds:{type:'array',items:{type:'string',enum:evidence.map(e=>e.id)}}},required:['field','value','evidenceIds'],additionalProperties:false}},warnings:{type:'array',items:{type:'string'}}},required:['summary','assertions','warnings'],additionalProperties:false};
}
/** Use the existing native scene contract: unlike literal boxes, it includes editable hex/edge/vertex slots. */
export function catanScenePrompt(session:Session,pack:GamePack,evidence:Evidence[]){
 return `Read only visible facts in this single public ${pack.title} photograph for KeepBoard's existing illustrated Catan board editor. Return the supplied JSON schema; summary/warnings are short Korean text. Photo id: ${JSON.stringify(evidence[0]?.id)}. Players (ownership context only): ${JSON.stringify(session.players.map(p=>({id:p.id,color:p.color})))}.
COMPONENT SCENE OUTPUT: One assertion, board.layout with coverage=full only if all 19 terrain cells are positively visible; otherwise components.observed with coverage=partial or catalog. Full terrain does not prove other layers complete. Never infer missing inventory, hidden state, turn/history or repair illegal play.
Inspect each physical kind, including small, overlapping and edge objects: terrain, number-token, road, settlement, city, robber, harbor, cards and loose pieces. Printed land regions count as terrain; a number disc is separate. Keep each visible object even if its value or slot is unreadable. Harbors are independent coastal-edge objects; preserve visible variant and ratio without generating expected ports.
Orient terrain rows 3,4,5,4,3 top to bottom in the photo, columns left to right. Hex ids are r{row}c{column}. Roads use edges {hexId}.{NE|E|SE|SW|W|NW}; settlements/cities use vertices {hexId}.{N|NE|SE|S|SW|NW}; terrain/number-token/robber use hexes. Any adjacent hex alias is valid. Use a readable slot; uncertain placement stays unplaced/null. Photo region is normalized original-photo x,y,width,height, independent of the diagram, or null if uncertain.
Use short unique component ids and preserve id/kind/quantity/location/region. Quantity is visible physical count or null if uncountable; zero requires observed zero. Retain every readable variant, number, observedColor, ratio, direction, face and attachment; a missing value must not remove an object. Include face=front when visibly front (including readable terrain/discs). Unknown stays null or omitted, never guessed. Omit optional null/inapplicable fields and empty notes; evidenceId may be omitted because there is one source photo. Keep assertion.evidenceIds. Retain observedColor independently; ownerId may be a supplied player id only with visible ownership or agreement with the supplied player color, otherwise omit/null. No private identities from card backs, deck order or inferred totals.`;
}
/** Fill the implicit single source only on a clone; explicit null/invalid source values remain provider evidence. */
function expandSinglePhotoSource(wire:unknown,evidenceId:string):unknown{
 const expanded=structuredClone(wire);
 if(!expanded||typeof expanded!=='object'||!Array.isArray((expanded as any).assertions))return expanded;
 for(const assertion of (expanded as any).assertions){
  if(!assertion||typeof assertion!=='object'||!Array.isArray(assertion.value?.components))continue;
  for(const component of assertion.value.components)if(component&&typeof component==='object'&&!Array.isArray(component)&&!Object.hasOwn(component,'evidenceId'))component.evidenceId=evidenceId;
 }
 return expanded;
}
export function decodeCatanSceneReading(native:unknown,input:{request:ObservationRequest;definition:PhotoDefinition;pack:GamePack;session:Session;evidence:Evidence[];reader:HostedReaderIdentity;sourceImageSHA:string}):AnalysisResult{
 const {request,definition,pack,session,evidence,reader}=input;
 if(definition.nativeBridge!=='catan'||request.areaId!=='board'||request.scope.partition!=='common_public'||request.images.length!==1||evidence.length!==1||request.images[0].evidenceId!==evidence[0].id||evidence.some(e=>e.ownerId))throw Error('카탄 공용 판 영역을 확인하세요.');
 const wire=decodeProviderJSON(native,'gemini',200) as {assertions?:unknown[]};
 const normalized=normalizeObservations(expandSinglePhotoSource(wire,evidence[0].id),pack,evidence,session.turnInstanceId,session.players.map(p=>p.id));
 normalized.assertions=normalized.assertions.filter(a=>!a.ownerId&&['board.layout','components.observed'].includes(a.field));
 const refs:Record<string,string>={};
 const observations=normalized.assertions.flatMap(a=>normalizeScene(a.value).components.map((c,index)=>{
  const ref=`${a.id}:${index}`,component=definition.components.find(d=>d.id===c.kind);refs[ref]=c.id;
  const properties:Record<string,any>={};
  for(const property of component?.properties??[]){
   if(!request.allowedPropertyIds[c.kind]?.includes(property.id)||property.acquisition!=='visible'||component!.manualPropertyIds.includes(property.id))continue;
   // Native scene face is optional. Do not impose the literal reader's front-only proof on that legacy optional field.
   // Keep the native value/placement and raw wire; omit this literal attribute unless an explicit front is present.
   if(property.faceOnly&&c.face!=='front')continue;
   const value=(c as unknown as Record<string,unknown>)[property.id];
   // The native scene already uses the same domain. Retain null as unknown rather than filling a default.
   if(value===null||value===undefined)properties[property.id]={state:'unknown',value:null,reason:'unreadable'};
   else{try{validateDetailValue(value,property);if(property.options&&property.type!=='marks'&&!property.options.some(o=>o.value===value))throw Error();properties[property.id]={state:'observed',value};}catch{properties[property.id]={state:'unknown',value:null,reason:'unsupported'};}}
  }
  return {ref,imageIndex:0,panelRef:null,componentId:component?c.kind:null,bbox:c.region,face:c.face??'unknown',quantity:c.quantity,rotationDegrees:null,properties,referenceCandidates:[]};
 }));
 const result=validateObservationResult({version:OBSERVATION_VERSION,observations,coverage:'partial',completion:'complete'},request,definition);
 const receipt:ObservationReceipt={version:OBSERVATION_VERSION,request:structuredClone(request),result,reader:structuredClone(reader),frame:null,transforms:[],geometryCandidates:[],componentRefs:refs,sourceImageSHA:input.sourceImageSHA,hostedWire:{id:'gemini-catan-scene-wire-v1',items:structuredClone(wire.assertions??[]),deferred:[]}};
 for(const assertion of normalized.assertions)assertion.observationReceipts=[receipt];
 return {...normalized,observationReceipts:[receipt]};
}
