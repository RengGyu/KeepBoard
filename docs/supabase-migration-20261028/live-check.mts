import assert from 'node:assert/strict';
import {readFile,writeFile} from 'node:fs/promises';
import {createHash,randomUUID} from 'node:crypto';
import {createClient} from '@supabase/supabase-js';
import {SupabaseObjects} from '../../server/supabaseObjects.ts';
import {CloudUploads} from '../../server/cloudUploads.ts';

// Dedicated disposable namespace only; never reads or mutates production data.
const url='https://lfwogdbjcczleflkprsm.supabase.co';
const serviceRoleKey=(await readFile('/private/tmp/kb-supabase-migration-secrets/server-key','utf8')).trim();
const prefix='migration-check-'+randomUUID();
const config={url,serviceRoleKey,bucket:'keepboard-private',prefix};
const first=new SupabaseObjects(config),second=new SupabaseObjects(config);
const bytes=Buffer.from('{"zero":0,"unknown":null,"text":"한글"}');
const original=await first.write('sessions/check.json',bytes,null,'application/json');
assert.deepEqual((await second.read('sessions/check.json'))?.data,bytes);
const races=await Promise.allSettled([first.write('sessions/check.json',bytes,original,'application/json'),second.write('sessions/check.json',bytes,original,'application/json')]);
assert.equal(races.filter(x=>x.status==='fulfilled').length,1);
assert.equal(races.filter(x=>x.status==='rejected'&&x.reason.status===409).length,1);
await assert.rejects(first.write('sessions/check.json',bytes,null,'application/json'),{status:409});
await assert.rejects(first.remove('sessions/check.json',original),{status:409});
const image=Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+a4N8AAAAASUVORK5CYII=','base64');
await first.write('uploads/check.png',image,null,'image/png');
assert.deepEqual((await second.read('uploads/check.png'))?.data,image);
assert.deepEqual((await first.list('')).sort(),['sessions/check.json','uploads/check.png']);
const uploads=new CloudUploads(first),meta={contentType:'image/png',scope:'player',ownerId:'evaluation-owner',label:'migration test'};
const ticket=await uploads.mint('evidence',meta,'evaluation-session','epoch-1');
assert.ok(ticket.signedUrl);
const sent=await fetch(ticket.signedUrl,{method:'PUT',headers:{'Content-Type':'image/png','x-upsert':'false'},body:image});
assert.equal(sent.status,200);
await assert.rejects(uploads.evidence(ticket.ticket,'evaluation-session','epoch-2',meta));
await assert.rejects(uploads.evidence(ticket.ticket,'evaluation-session','epoch-1',{...meta,ownerId:'other-owner'}));
const attached=await uploads.evidence(ticket.ticket,'evaluation-session','epoch-1',meta);
assert.deepEqual((await first.read(attached.slice(1)))?.data,image);
const overwrite=await fetch(ticket.signedUrl,{method:'PUT',headers:{'Content-Type':'image/png','x-upsert':'false'},body:image});
assert.ok(!overwrite.ok);
const publicKey='sb_publishable_DTc8jnjVHc2YrcN5GHaP-g_-6hrO7Y2';
const anonymous=await fetch(url+'/rest/v1/keepboard_objects?select=key',{headers:{apikey:publicKey}});
assert.ok(anonymous.status===401||anonymous.status===403);
const report={checkedAt:new Date().toISOString(),projectRef:'lfwogdbjcczleflkprsm',productionMigration:false,checks:{crossClientBytes:true,zeroAndNullPreserved:true,atomicCas:true,createOnly:true,staleDeleteRejected:true,privateImageBytes:true,listing:true,signedUpload:true,ownerAndEpochRejection:true,signedOverwriteRejected:true,anonymousDenied:anonymous.status},imageSHA256:createHash('sha256').update(image).digest('hex')};
// Dispose only objects generated by this invocation.
for(const key of await first.list('')){const object=await first.read(key);if(object)await first.remove(key,object.etag);}
const admin=createClient(url,serviceRoleKey,{auth:{persistSession:false,autoRefreshToken:false}});
for(const folder of ['objects','direct']){const {data:files,error}=await admin.storage.from(config.bucket).list(prefix+'/'+folder);if(error)throw error;if(files?.length){const removed=await admin.storage.from(config.bucket).remove(files.map(x=>prefix+'/'+folder+'/'+x.name));if(removed.error)throw removed.error;}}
await writeFile(new URL('./live-check.json',import.meta.url),JSON.stringify(report,null,2)+'\n');
console.log(JSON.stringify(report));
