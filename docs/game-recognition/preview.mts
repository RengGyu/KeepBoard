import {mkdtemp,writeFile,readFile} from 'node:fs/promises';import os from 'node:os';import path from 'node:path';
const project=process.cwd(),root=await mkdtemp(path.join(os.tmpdir(),'kb-recognition-preview-'));
for(const key of ['OPENAI_API_KEY','GEMINI_API_KEY','GOOGLE_API_KEY','DEEPSEEK_API_KEY','AI_PROVIDER','AI_MODEL','AI_BASE_URL','AI_GATEWAY_URL','KEEPBOARD_AI_GATEWAY_URL','KEEPBOARD_AI_ALIAS'])delete process.env[key];
process.env.KEEPBOARD_DATA_DIR=root;process.env.NODE_ENV='production';await writeFile(path.join(root,'ai-settings.json'),JSON.stringify({provider:'openai',model:'synthetic-mock-only',apiKey:'NOT-A-REAL-KEY'}));process.chdir(root);const {createApp}=await import('../../server/index.ts');const {Store}=await import('../../server/store.ts');const {normalizeObservations}=await import('../../server/ai/index.ts');process.chdir(project);
const record=(id:string,componentId:string,label:string,evidenceId:string|null=null)=>({version:'game-component-record-v1',pieces:[{id,componentId,variant:null,quantity:1,label,anchor:'합성 테이블',evidenceId,region:evidenceId?{x:.15,y:.7,width:.65,height:.18}:null}]});
let calls=0;const app=await createApp({store:new Store(root,path.join(project,'public')),ui:false,analyzer:async(input)=>{calls++;return normalizeObservations({summary:'합성 모델 결과 · 실AI 미호출',assertions:[{field:'__photo.public',value:record('model-chips','chips','파란 보석 표식',input.evidence[0].id),evidenceIds:input.evidence.map(e=>e.id)}]},input.pack,input.evidence,input.session.turnInstanceId,input.session.players.map(p=>p.id));}});
const {createServer}=await import('vite');const vite=await createServer({root:project,envDir:false,server:{middlewareMode:true,hmr:false},appType:'spa'});app.use(vite.middlewares);const server=app.listen(4405,'127.0.0.1');await new Promise<void>((ok,fail)=>{server.once('listening',ok);server.once('error',fail);});const base='http://127.0.0.1:4405';const call=async(route:string,body:unknown,method='POST')=>{const r=await fetch(base+route,{method,headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const v=await r.json();if(!r.ok)throw new Error(JSON.stringify(v));return v;};
const created=await call('/api/sessions',{gamePackId:'splendor',name:'[합성검수] 스플렌더 사진 연결',players:[{id:'p1',name:'합성 하나',color:'#c65d4b'},{id:'p2',name:'합성 둘',color:'#6285aa'}]}),id=created.session.id;
await call('/api/sessions/'+id,{answers:[{field:'market.scene',value:record('keep-card','development','기존 카드 기록')},{field:'noble-area.scene',value:record('keep-noble','nobles','기존 귀족 기록')}]},'PATCH');
const photo=await call('/api/sessions/'+id+'/evidence',{scope:'public',label:'검증용 합성 그림 · 실사진 아님',dataUrl:'data:image/png;base64,'+(await readFile(path.join(project,'docs/game-recognition/synthetic-table.png'))).toString('base64')});
const info={base,url:base+'/?session='+id,sessionId:id,dataDir:root,synthetic:true,mock:true,realAI:false,photoId:photo.createdEvidenceId};await writeFile(path.join(project,'docs/game-recognition/preview.json'),JSON.stringify(info,null,2)+'\n');app.get('/synthetic-diagnostics',(_req,res)=>res.json({calls}));console.log(JSON.stringify(info));
