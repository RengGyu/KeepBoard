import {readFile,writeFile} from 'node:fs/promises';import type {GamePack} from '../../shared/types.ts';import {recognitionCapability,recognitionFields} from '../../shared/recognition.ts';
const packs:GamePack[]=JSON.parse(await readFile(new URL('../../gamepacks/generated/game-essentials.json',import.meta.url),'utf8'));
const games=packs.map(pack=>{const c=recognitionCapability(pack);return {gameId:pack.id,version:pack.version,sourceSHA:pack.runtime?.source.sha256,mode:c.mode,eligible:c.bindings.map(b=>({key:b.key,scope:b.scope,visibility:b.visibility,editor:b.editor})),excluded:c.excluded,publicFields:recognitionFields(pack).map(f=>f.key),ownerFields:recognitionFields(pack,'synthetic-owner').map(f=>f.key)};});
const report={native:games.filter(g=>g.mode==='native').length,assisted:games.filter(g=>g.mode==='assisted').length,manual:games.filter(g=>g.mode==='manual').length,photoScalar:games.flatMap(g=>g.eligible).filter(b=>b.editor==='scalar').length,games};
const text=JSON.stringify(report,null,2)+'\n',target=new URL('./coverage.json',import.meta.url);if(process.argv.includes('--check')){if(await readFile(target,'utf8')!==text)throw new Error('coverage drift');}else await writeFile(target,text);console.log(JSON.stringify({games:games.length,native:report.native,assisted:report.assisted,manual:report.manual,eligible:games.flatMap(g=>g.eligible).length,publicGames:games.filter(g=>g.publicFields.length).length,ownerGames:games.filter(g=>g.ownerFields.length).length}));
