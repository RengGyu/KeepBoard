 const reader=new TerraGameReader({profile:j.profile,key:async()=>key,fetch:async(url,init)=>{assert.equal(sha(String(init?.body)),j.bodySHA);const t=performance.now(),r=await fetch(url,init);row.http=r.status;const text=await r.text();row.providerMs=performance.now()-t;await fs.writeFile(priv+'/'+j.id+'.native.json',text,{flag:'wx',mode:0o600});if(!r.ok){halt=true;return new Response(text,{status:r.status});}const v=JSON.parse(text);row.usage=v.usage;row.estimatedUSD=(v.usage.input_tokens+v.usage.output_tokens*5)/1e6;if(rows.reduce((n,r)=>n+(r.estimatedUSD??0),0)>4)halt=true;return Response.json(v);}});
 const result=await reader.read(j.request,j.definition,await fs.readFile(j.c.path),'image/jpeg');const bytes=JSON.stringify(result);await fs.writeFile(priv+'/'+j.id+'.decoded.json',bytes,{flag:'wx',mode:0o600});row.decodedSHA=sha(bytes);row.observations=result.raw.observations.length;row.readerMs=result.timings.readerMs;row.state='completed';
 }catch(e:any){if(row.http!==200)halt=true;row.state='failed';row.error=String(e.message??e).replaceAll(key,'[REDACTED]');}finally{active--;await fs.writeFile(`${out}/${batch}-execution.json`,JSON.stringify({batch,calls,peak,retries:0,halt,wallMs:performance.now()-start,rows},null,2)+'\n');console.log(JSON.stringify({id:row.id,state:row.state,http:row.http,seconds:row.providerMs/1000,observations:row.observations}));}}}));
console.log(JSON.stringify({batch,calls,peak,halt,completed:rows.filter(r=>r.state==='completed').length}));
