const sources=await Promise.all(['server/ai/terraGameReader.ts','server/ai/terraCompact.ts','server/ai/geminiGameReader.ts','server/ai/observationAssembly.ts','server/scanObservation.ts','shared/lightweightRecognition.ts','server/photoDefinitions.ts','game-photo-definitions/index.json'].map(async path=>({path,sha256:sha(await fs.readFile(path))})));
