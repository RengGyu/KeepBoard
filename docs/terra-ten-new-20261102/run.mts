const rows:any[]=old?.rows??[],priorIds=new Set(rows.map(r=>r.id));for(let i=jobs.length-1;i>=0;i--)if(priorIds.has(jobs[i].id))jobs.splice(i,1);
let next=0,calls=rows.length,active=0,peak=old?.peak??0,halt=false;const start=performance.now();
