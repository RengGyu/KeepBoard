// Test-only local app. Replays six frozen provider responses; no external model requests.
import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
import {createApp} from '../../server/index.ts';import {Store} from '../../server/store.ts';import {GeminiGameReader,decodeGeminiGameObservation} from '../../server/ai/geminiGameReader.ts';import {photoDefinition} from '../../server/photoDefinitions.ts';import {effectiveRecognitionPack} from '../../shared/recognition.ts';
const doc=path.dirname(new URL(import.meta.url).pathname),privateRoot=path.join(os.homedir(),'Library/Application Support/KeepBoard/research/multiview-followup-20261029'),plan=JSON.parse(await fs.readFile(new URL('../multiview-followup-20261029/plan.json',import.meta.url),'utf8')),ledger=JSON.parse(await fs.readFile(new URL('../multiview-followup-20261029/ledger.json',import.meta.url),'utf8')),sha=(x:any)=>createHash('sha256').update(x).digest('hex');
const natives=new Map<string,any>();for(const r of ledger){const b=await fs.readFile(path.join(privateRoot,r.gameId+'.'+r.variant+'.native.json'));assert.equal(sha(b),r.rawSHA);natives.set(r.inputSHA,JSON.parse(b.toString()));}
class SavedReader extends GeminiGameReader{reads=0;async status(){return {kind:'gemini-game-observation-v1' as const,available:true,cloudSupported:true as const,identity:this.identity};}async read(request:any,definition:any,image:Buffer,_mime:string,transforms:any[]=[]){this.reads++;const native=natives.get(sha(image));assert(native,'Only frozen image inputs allowed');return {raw:decodeGeminiGameObservation(native,request,definition,undefined,transforms),timings:{readerMs:1}};}}
const temp=await fs.mkdtemp(path.join(os.tmpdir(),'kb-fusion-ui-')),store=new Store(temp),reader=new SavedReader(),app=await createApp({store,geminiReader:reader,ui:true,uiHmr:false}),server=app.listen(0,'127.0.0.1');await new Promise<void>(r=>server.once('listening',r));const base='http://127.0.0.1:'+(server.address() as any).port,nativeFetch=globalThis.fetch;
globalThis.fetch=async(input:any,init?:any)=>{if(!String(input).startsWith(base))throw Error('QA external fetch forbidden');return nativeFetch(input,init);};
const call=async(p:string,b?:any)=>{const r=await fetch(base+'/api'+p,{method:b?'POST':'GET',headers:{'Content-Type':'application/json'},body:b?JSON.stringify(b):undefined});const v=await r.json();assert(r.ok,JSON.stringify({p,status:r.status,v}));return v;};
const sessions=[];
for(const c of plan.cases){let view=await call('/sessions',{gamePackId:c.packId,name:'[저장 응답 검수] '+c.gameId,recordingMode:'simple'});const route='/sessions/'+view.session.id,epoch=view.session.captureEpoch,runId='frozen-pair',items=[{clientPhotoId:'whole',scope:'public',contentType:'image/jpeg',label:'전체 사진',width:c.width,height:c.height},{clientPhotoId:'crop',scope:'public',contentType:'image/png',label:'부분 사진',width:c.cropDimensions.width,height:c.cropDimensions.height,parentClientId:'whole',sourceRegion:c.sourceRegion}];
 await call(route+'/upload-batch',{runId,expectedCaptureEpoch:epoch,items});const bytes=[await fs.readFile(c.path),await fs.readFile(c.cropPath)];await Promise.all(items.map((x,i)=>call(route+'/upload-batch/'+runId+'/files/'+x.clientPhotoId,{dataUrl:'data:'+x.contentType+';base64,'+bytes[i].toString('base64')})));view=await call(route+'/evidence-batch',{runId,expectedCaptureEpoch:epoch,clientPhotoIds:['whole','crop']});
 const def=photoDefinition(effectiveRecognitionPack(view.session.gamePack));const job=await call(route+'/analysis-jobs',{requestId:'saved-pair-once',evidenceIds:view.createdEvidenceIds,expectedCaptureEpoch:epoch,scope:'public',sameStaticState:true,reader:{kind:'gemini-game-observation-v1',definitionSHA:def.definitionSHA,areaId:c.gameId==='splendor-duel'?'board':c.areaId}});
 for(let n=0;n<50;n++){const x=await call(route+'/analysis-jobs/'+job.job.id+'/progress');if(x.job&&!['queued','running'].includes(x.job.state)){assert.equal(x.job.state,'completed');break;}await new Promise(r=>setTimeout(r,100));}
 view=await call(route);const accepted=view.session.assertions.filter((a:any)=>a.status==='accepted'&&a.observationReceipts?.length);const entry={gameId:c.gameId,id:view.session.id,url:base+'/?session='+view.session.id,acceptedFields:accepted.map((a:any)=>({field:a.field,pieces:a.value.pieces?.length??a.value.components?.length??0,receipts:a.observationReceipts.length,fusion:!!a.observationReceipts.at(-1)?.scanBundle?.fusion}))};sessions.push(entry);
}
assert.equal(reader.reads,6);const report={base,pid:process.pid,tempRoot:temp,modelCalls:0,savedResponseReaderReads:reader.reads,sessions};await fs.writeFile(path.join(doc,'preview.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report));
process.on('SIGTERM',()=>server.close(()=>process.exit(0)));
