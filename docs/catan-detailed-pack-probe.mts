// Read-only product review. Synthetic sessions only; no settings, network, Store or real photos.
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {readFile,writeFile} from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {catanPack} from '../gamepacks/catan.ts';
import {answerField,recompute,nextTurn} from '../server/engine.ts';
import {observationPrompt} from '../server/ai/prompt.ts';
import {sceneObservationInstructions} from '../server/ai/scenePrompt.ts';
import {normalizeObservations} from '../server/ai/index.ts';
import {CATAN_TOPOLOGY,createComponent,sceneJSONSchema,type ComponentScene} from '../shared/scene.ts';
import {hasCompleteBoard} from '../shared/sceneBridge.ts';
import {canonicalBoard,playerSummary,inspectTrade} from '../shared/catanSummary.ts';
import type {Session,Evidence,Value} from '../shared/types.ts';
const here=path.dirname(fileURLToPath(import.meta.url));
const p=structuredClone(catanPack);
const seed=():Session=>({id:'review-synthetic',name:'합성 검토',createdAt:'2026-10-21',updatedAt:'2026-10-21',gamePackId:p.id,gamePackVersion:p.version,gamePack:structuredClone(p),captureEpoch:'e1',turnInstanceId:'t1',stage:'capture',players:[{id:'r',name:'A',color:'#cf6656'},{id:'b',name:'B',color:'#5c83a8'}],evidence:[],assertions:[],preservations:[],snapshots:[],notes:{},activity:[],example:false});
const set=(s:Session,key:string,value:unknown,ownerId?:string)=>answerField(s,s.gamePack!,key,value as Value,ownerId);
const current=seed();set(current,'currentPlayer','r');set(current,'turn.phase','action');set(current,'turn.developmentCardBoughtThisTurn',true);set(current,'player.development.boughtThisTurnType','knight','r');set(current,'player.development.handCounts',{knight:1,'road-building':0,'year-of-plenty':0,monopoly:0,'victory-point':0},'r');
recompute(current,current.gamePack!);assert.ok(current.assertions.some(a=>a.field==='player.development.newActionCardUnavailableThisTurn'&&a.ownerId==='r'&&a.value===true));
nextTurn(current,current.gamePack!,'b');const later=recompute(current,current.gamePack!);
const stale= later.derived.find(a=>a.field==='player.development.newActionCardUnavailableThisTurn'&&a.ownerId==='r');
assert.equal(stale?.value,true);assert.equal(current.assertions.find(a=>a.field==='player.development.handCounts')?.value&&current.assertions.some(a=>a.field==='player.development.boughtThisTurnType'),true);
nextTurn(current,current.gamePack!,'r');assert.ok(recompute(current,current.gamePack!).derived.some(a=>a.field==='player.development.newActionCardUnavailableThisTurn'&&a.ownerId==='r'&&a.value===true));

const empty:ComponentScene={version:2,coverage:'partial',components:[]};
const tiles=CATAN_TOPOLOGY.hexes.map((h,i)=>createComponent(empty,'terrain',{id:`tile-${i}`,variant:i===0?'desert':'forest',quantity:1,location:{type:'hex',id:h.id}}));
const house=createComponent(empty,'settlement',{id:'house',quantity:1,ownerId:'r',location:{type:'vertex',id:CATAN_TOPOLOGY.vertices[0].id}});
const complete:ComponentScene={version:2,coverage:'full',coverageByLayer:{buildings:'complete',roads:'complete'},components:[...tiles,house]};
assert.equal(hasCompleteBoard(complete),true);
const catalogSession=seed();set(catalogSession,'components.observed',complete);recompute(catalogSession,catalogSession.gamePack!);
assert.equal(canonicalBoard(catalogSession).scene.components.length,0);assert.equal(playerSummary(catalogSession,'r').pieces.settlement.known,0);
const boardSession=seed();set(boardSession,'board.layout',complete);recompute(boardSession,boardSession.gamePack!);
assert.equal(playerSummary(boardSession,'r').pieces.settlement.value,1);
const partial=seed();set(partial,'board.layout',{...complete,coverage:'partial',coverageByLayer:{}});const partialView=recompute(partial,partial.gamePack!);
assert.ok(partialView.questions.some(q=>q.field==='board.layout'));
const unknownLayers=seed();set(unknownLayers,'board.layout',{...complete,coverageByLayer:{}});recompute(unknownLayers,unknownLayers.gamePack!);
assert.equal(playerSummary(unknownLayers,'r').pieces.settlement.value,null);
assert.equal(playerSummary(boardSession,'r').publicScore.value,null);
set(boardSession,'awards.longestRoadHolder','none');set(boardSession,'awards.largestArmyHolder','none');recompute(boardSession,boardSession.gamePack!);
assert.equal(playerSummary(boardSession,'r').publicScore.value,1);

const changing=seed();set(changing,'currentPlayer','r');set(changing,'turn.actionDevelopmentCardPlayed',true);set(changing,'currentPlayer','b');recompute(changing,changing.gamePack!);
assert.equal(changing.turnInstanceId,'t1');assert.ok(changing.assertions.some(a=>a.field==='turn.actionDevelopmentCardLimitReached'&&a.value===true));
const sceneSnapshot={epoch:changing.captureEpoch,turn:changing.turnInstanceId};recompute(changing,changing.gamePack!);assert.deepEqual({epoch:changing.captureEpoch,turn:changing.turnInstanceId},sceneSnapshot);

const hidden=seed();set(hidden,'player.development.handCounts',{'victory-point':2},'r');set(hidden,'player.score.hiddenVictoryPoints',2,'r');set(hidden,'player.development.handCounts',{'victory-point':0},'r');recompute(hidden,hidden.gamePack!);
assert.equal(playerSummary(hidden,'r').totalScore.known,2);
const countsConflict=seed();set(countsConflict,'player.resources.total',7,'r');set(countsConflict,'player.resources.counts',{lumber:2,brick:0,wool:0,grain:0,ore:0},'r');recompute(countsConflict,countsConflict.gamePack!);
const totalConflict=playerSummary(countsConflict,'r').resourceTotal;assert.equal(totalConflict.status,'conflict');assert.equal(totalConflict.value,7);assert.equal(playerSummary(countsConflict,'r').resources.value,2);
const trade=inspectTrade(countsConflict,{kind:'bank',playerId:'r',give:{lumber:3},receive:{ore:1},status:'proposed',given:null,received:null});assert.equal(trade.validRatio,false);assert.ok(trade.messages.length>1);
const photo:Evidence={id:'synthetic-photo',url:'data:image/jpeg;base64,AA==',capturedAt:'synthetic',captureEpoch:'e1',scope:'public',kind:'photo',label:'합성 참조'};
const publicDefs=p.fields.filter(f=>f.acquisition==='observe'&&(f.scope==='public'||f.visibility==='public'));
const privateDefs=p.fields.filter(f=>f.acquisition==='observe'&&f.scope==='player');
const derivedTargets=new Set(p.derivedRules.map(r=>r.field));
const projection=publicDefs.map(({key,label,description,type,scope,visibility,presentation,options})=>({key,label,description,type,scope,visibility,presentation,options}));
const publicPrompt=observationPrompt(seed(),p,[photo]);const privatePrompt=observationPrompt(seed(),p,[{...photo,scope:'player',ownerId:'r'}]);
const priorContext=seed();set(priorContext,'board.layout',complete);set(priorContext,'player.resources.counts',{lumber:3},'r');
const contextPrompt=observationPrompt(priorContext,p,[photo]);assert.ok(!contextPrompt.includes('"lumber":3'));
const derivedCandidate=normalizeObservations({assertions:[{field:'turn.actionDevelopmentCardLimitReached',value:true,evidenceIds:[photo.id]}]},p,[photo],'t1',['r','b']);
assert.equal(derivedCandidate.assertions.length,1);
const details={status:'passed',scope:'synthetic contract/reachability review; not real recognition or browser/deployment verification',realAPICalls:0,pack:{bytes:Buffer.byteLength(JSON.stringify(p)),fields:p.fields.length,requirements:p.requirements.length,derivedRules:p.derivedRules.length,preservations:p.preservationTemplates.length},scanPrompt:{freshPublicBytes:Buffer.byteLength(publicPrompt),freshPrivateBytes:Buffer.byteLength(privatePrompt),sceneInstructionBytes:Buffer.byteLength(sceneObservationInstructions(p)),publicAllowedFields:publicDefs.map(f=>f.key),privateAllowedFields:privateDefs.map(f=>f.key),derivedTargetsAllowedPublic:publicDefs.filter(f=>derivedTargets.has(f.key)).map(f=>f.key),derivedTargetsAllowedPrivate:privateDefs.filter(f=>derivedTargets.has(f.key)).map(f=>f.key),withSyntheticAcceptedBoardBytes:Buffer.byteLength(contextPrompt),privateHandExcludedFromPublicContext:true,transmitsFullPack:false,formalResponseSchemaInTransport:false},confirmed:{purchaseTypePersistsButTurnRestrictionIncorrectlyRederived:true,fullyObservedCatalogIgnoredByCanonicalSummary:true,full19PartialFlagStillRequiresBoardAnswer:true,missingLayerCoveragePreventsExactPieceTotals:true,titleHoldersUnrecordedMakesScoreUnknown:true,changingCurrentPlayerDoesNotStartNewTurn:true,staleHiddenVPOverrideSurvivesHandCountCorrection:true,derivedOnlyBooleanAcceptedAsPhotoCandidate:true,recomputeDoesNotRotateTurnOrEpoch:true,resourceConflict:{separateTotal:7,completeCounts:2,returnedTotal:totalConflict.value,status:totalConflict.status},invalidTrade:{validRatio:trade.validRatio,messages:trade.messages}},notes:['Current-player update is also used for correction; not all such updates should advance a turn. The UI lacks a separate next-turn action.','Unknown counts/scores are conservative behavior, but missing UI confirmation entry prevents resolving them.','Retaining card identity is correct; deriving current-turn restriction from lifetime=session identity without a turn predicate is the defect.']};
Object.assign(details.scanPrompt,{publicFieldDefinitionsBytes:Buffer.byteLength(JSON.stringify(publicDefs)),publicFieldDefinitionsWithoutUiAndRuleMetadataBytes:Buffer.byteLength(JSON.stringify(projection)),sceneSchemaBytes:Buffer.byteLength(JSON.stringify(sceneJSONSchema))});
Object.assign(details,{sourceSha256:Object.fromEntries(await Promise.all(['gamepacks/catan.ts','gamepacks/catanProfile.ts','server/engine.ts','server/ai/prompt.ts','server/ai/index.ts','shared/catanSummary.ts','shared/scene.ts','src/SessionWorkspace.tsx','src/SceneWorkspace.tsx','src/SceneEditor.tsx','src/CatanOverview.tsx'].map(async file=>[file,createHash('sha256').update(await readFile(path.join(here,'..',file))).digest('hex')])))});
await writeFile(path.join(here,'catan-detailed-pack-probe.json'),JSON.stringify(details,null,2)+'\n');
console.log(JSON.stringify({status:'PASS: synthetic boundary findings reproduced; no product changes / API calls',pack:details.pack,prompt:details.scanPrompt.freshPublicBytes,derivedPublic:details.scanPrompt.derivedTargetsAllowedPublic,derivedPrivate:details.scanPrompt.derivedTargetsAllowedPrivate}));
