 const id=c.caseId+'-default-replay',data=JSON.stringify(result);await fs.writeFile(priv+'/'+id+'.decoded.json',data,{mode:0o600});await fs.copyFile(priv+'/'+c.id+'.native.json',priv+'/'+id+'.native.json');calls.push({...c,id,condition:'default-replay',profile:TERRA_IDENTITY.adapterVersion});rows.push({id,state:'completed',providerMs:0,decodedSHA:sha(data)});
