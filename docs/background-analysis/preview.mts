import {mkdtemp,writeFile} from 'node:fs/promises';import os from 'node:os';import path from 'node:path';import {pathToFileURL} from 'node:url';import {readFileSync} from 'node:fs';
const {isolation:appRoot}=JSON.parse(readFileSync(new URL('./baseline.json',import.meta.url),'utf8'));
const root=await mkdtemp(path.join(os.tmpdir(),'keepboard-background-preview-'));process.chdir(root);process.env.KEEPBOARD_DATA_DIR=root;for(const k of ['OPENAI_API_KEY','GEMINI_API_KEY','GOOGLE_API_KEY','KEEPBOARD_AI_GATEWAY_URL'])delete process.env[k];
await writeFile(path.join(root,'ai-settings.json'),JSON.stringify({provider:'gemini',model:'mock-no-network',apiKey:'synthetic-not-a-key'}),{mode:0o600});
const {createApp}=await import(pathToFileURL(path.join(appRoot,'server/index.ts')).href);const {Store}=await import(pathToFileURL(path.join(appRoot,'server/store.ts')).href);const {normalizeObservations}=await import(pathToFileURL(path.join(appRoot,'server/ai/index.ts')).href);
process.chdir(appRoot);process.env.NODE_ENV='production';
let calls=0;const app=await createApp({store:new Store(root,path.join(appRoot,'public')),ui:true,analyzer:async(input:any)=>{calls++;console.log(JSON.stringify({stage:'mock-start',calls,photos:input.evidence.length}));await new Promise(r=>setTimeout(r,20000));return normalizeObservations({assertions:[{field:'__photo.public',value:{version:'game-component-record-v1',pieces:[{id:'mock-token',componentId:'chips',variant:null,quantity:2,label:'합성 보석',anchor:'',evidenceId:input.evidence[0].id,region:null,readout:{schema:'splendor-v1',kind:'token',points:null,bonus:null,cost:{white:null,blue:null,green:null,red:null,black:null},requirements:{white:null,blue:null,green:null,red:null,black:null},color:'blue',level:null}}]},evidenceIds:[input.evidence[0].id]}],summary:'합성 지연 mock · 실AI 아님'},input.pack,input.evidence,input.session.turnInstanceId,input.session.players.map((p:any)=>p.id));}});
app.listen(4408,'127.0.0.1',()=>console.log(JSON.stringify({url:'http://127.0.0.1:4408',root,mock:true,externalCalls:0})));
